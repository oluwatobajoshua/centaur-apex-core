root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 88

[*.ts]
indent_size = 2
max_line_length = 100

[*.{json,yml,yaml,md,ps1,sh}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false