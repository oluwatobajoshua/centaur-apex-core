# Line endings
* text=auto

# Source files: always LF
*.py text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binaries
*.exe binary
*.png binary
*.jpg binary
*.ico binary

# Never-normalize lockfiles is a myth — normalize them:
Cargo.lock text eol=lf